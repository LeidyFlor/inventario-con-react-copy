# Copia este archivo como .env y completa los valores con tu proyecto de Supabase ESTA ES UNA PLANTILLA DE EJEMPLO

# Django
SECRET_KEY=tu-secret-key-aqui
DEBUG=True

# Supabase - PostgreSQL (Transaction Pooler)
# Valores en: Supabase → Settings → Database → Transaction Pooler
#
# Se usa el pooler de TRANSACCIONES (puerto 6543), no el de sesión (5432):
# devuelve la conexión al pool al terminar cada transacción, que es lo que
# necesita Django con CONN_MAX_AGE = 0. El usuario mantiene el formato
# postgres.<referencia-del-proyecto>, igual que en el pooler de sesión.
DB_NAME=postgres
DB_USER=postgres.acwnkaahiwfgiuabgcih
DB_PASSWORD=tu-password-aqui
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=6543
